# --- Meta WhatsApp Cloud API (só conversas individuais; não funciona em grupos) ---
META_PHONE_NUMBER_ID=1425944217261984
META_WABA_ID=707514845256475
META_APP_SECRET=...            # valida a assinatura X-Hub-Signature-256 dos webhooks
META_ACCESS_TOKEN=...          # token permanente de System User (Business Settings → System Users → Generate token, permissões whatsapp_business_messaging e whatsapp_business_management)
META_VERIFY_TOKEN=gere-um-texto-e-use-o-mesmo-ao-cadastrar-o-webhook-na-Meta

# --- Z-API (grupos e número "como aplicativo") ---
ZAPI_INSTANCE_ID=...
ZAPI_INSTANCE_TOKEN=...
ZAPI_CLIENT_TOKEN=...          # header Client-Token (Segurança → Token de segurança da conta)
ZAPI_WEBHOOK_SECRET=gere-e-use-em-?s= na URL do webhook
META_REPASSE_SECRET=

# 1 = só observa (recusa qualquer envio). Tire quando a Cláudia for responder.
